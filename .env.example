# Public client origin used by Better Auth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Express API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
# ImgBB API key exposed to the browser upload flow.
NEXT_PUBLIC_IMGBB_API_KEY=
# Better Auth server base URL.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted browser origins for Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Better Auth signing secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# MongoDB connection string for Better Auth.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/booknook
# MongoDB database name.
MONGODB_DB=booknook
# Google OAuth client ID.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
